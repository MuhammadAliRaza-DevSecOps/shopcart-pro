<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - ShopCart Pro</title>
  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/responsive.css" />
</head>
<body class="auth-page">
  <div class="auth-wrapper">
    <div class="auth-logo">ShopCart Pro</div>

    <div class="amazon-auth-card">
      <h1>Sign in</h1>

      <form id="loginForm" class="amazon-auth-form">
        <label for="loginEmail">Email</label>
        <input type="email" id="loginEmail" placeholder="Enter your email" required />

        <label for="loginPassword">Password</label>
        <input type="password" id="loginPassword" placeholder="Enter your password" required />

        <button type="submit" class="amazon-btn">Sign in</button>
      </form>

      <p id="loginMessage" class="auth-message"></p>

      <p class="auth-small-text">
        By continuing, you agree to ShopCart Pro's conditions of use and privacy notice.
      </p>
    </div>

    <div class="auth-divider">
      <span>New to ShopCart Pro?</span>
    </div>

    <a href="register.html" class="amazon-secondary-btn">Create your ShopCart Pro account</a>
  </div>

  <script src="js/api.js"></script>
  <script src="js/auth.js"></script>
</body>
</html>