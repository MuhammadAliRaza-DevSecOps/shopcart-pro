<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout - ShopCart Pro</title>
  <link rel="stylesheet" href="css/style.css" />
  <link rel="stylesheet" href="css/responsive.css" />
</head>
<body>
  <header class="topbar">
    <div class="logo">ShopCart Pro</div>
    <nav class="nav" id="site-nav"></nav>
  </header>

  <section class="section">
    <h2>Checkout</h2>
    <div class="checkout-grid">
      <div class="auth-card">
        <h3>Shipping Information</h3>
        <form id="checkoutForm" class="amazon-auth-form">
          <label>Full Name</label>
          <input type="text" id="fullName" required />

          <label>Phone</label>
          <input type="text" id="phone" required />

          <label>City</label>
          <input type="text" id="city" required />

          <label>Address</label>
          <input type="text" id="address" required />

          <button type="submit" class="amazon-btn">Place Order</button>
        </form>

        <p id="checkoutMessage" class="auth-message"></p>
      </div>

      <div class="cart-summary">
        <h3>Order Summary</h3>
        <div id="checkout-items"></div>
        <h3 id="checkout-total">Total: PKR 0</h3>
      </div>
    </div>
  </section>

  <script src="js/api.js"></script>
  <script src="js/navbar.js"></script>
  <script src="js/checkout.js"></script>
</body>
</html>